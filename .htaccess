Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?:git|svn|hg)(?:/|$) - [F,L,NC]
  RewriteRule ^(index|dashboard|assets|reports)\.html$ $1.php [R=302,L,NC]
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,END]
</IfModule>

<FilesMatch "^(?:\.|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README(?:\.md)?|Readme\.md|.*\.sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
